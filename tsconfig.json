{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2023"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "rootDir": "src",
        "outDir": "dist",
        "types": [
            "@girs/gjs",
            "@girs/gjs/dom",
            "@girs/gnome-shell/ambient",
            "@girs/gnome-shell/extensions/global"
        ]
    },
    "include": ["src"]
}
