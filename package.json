{
    "name": "glass-ime",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && cp metadata.json stylesheet.css dist/",
        "check": "tsc --noEmit && tsc -p tools --noEmit && oxlint && oxfmt --check",
        "lint": "oxlint",
        "format": "oxfmt",
        "reload": "gnome-extensions disable glass-ime@tomo && gnome-extensions enable glass-ime@tomo",
        "capture": "tsc -p tools && gjs -m build/tools/capture/main.js"
    },
    "devDependencies": {
        "@girs/gdk-3.0": "3.24.43-4.0.0-beta.15",
        "@girs/gnome-shell": "46.0.2",
        "@girs/gtk-3.0": "3.24.43-4.0.0-beta.15",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "@girs/atk-1.0": "2.52.0-4.0.0-beta.15",
